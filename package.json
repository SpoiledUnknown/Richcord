{
  "name": "richcord",
  "version": "1.0.1",
  "description": "Cross-platform Discord Rich Presence client and CLI.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "richcord": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch cli/index.ts",
    "start": "tsx cli/index.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "eslint src cli",
    "lint:fix": "eslint src cli --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docs": "typedoc",
    "build:docs": "npm run build && npm run docs",
    "build:bundle": "npm run build && esbuild dist/cli/index.js --bundle --platform=node --format=cjs --outfile=build/richcord.cjs",
    "build:cli": "esbuild dist/cli/index.js --bundle --platform=node --format=cjs --outfile=release/richcord.cjs",
    "build:sea": "npm run build:bundle && node --build-sea sea-config.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpoiledUnknown/Richcord.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/SpoiledUnknown/Richcord/issues"
  },
  "homepage": "https://github.com/SpoiledUnknown/Richcord#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.8",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "inquirer": "^14.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
